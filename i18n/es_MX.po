# In-game shader picker.
msgid "Advanced RetroArch menu"
msgstr "Menú avanzado de RetroArch"

msgid "All RetroArch"
msgstr "Todo RetroArch"

msgid "All RetroArch requires a Leaf build with Fugazi's conflict resolver."
msgstr "Todo RetroArch requiere una versión de Leaf con el resolvedor de conflictos de Fugazi."

msgid "Remove the saved preset at the selected scope and turn shaders off."
msgstr "Eliminar el ajuste predefinido guardado en el alcance seleccionado y desactivar los shaders."

msgid "Edit the current shader in RetroArch."
msgstr "Editar el shader actual en RetroArch."

msgid "Leaf's in-game picker supports GLSL presets (.glslp)."
msgstr "El selector en juego de Leaf es compatible con ajustes predefinidos GLSL (.glslp)."

msgid "Leaf's shader files are incomplete. Update or reinstall Leaf."
msgstr "Los archivos de shaders de Leaf están incompletos. Actualiza o reinstala Leaf."

msgid "No saved shader exists at that scope."
msgstr "No existe ningún shader guardado en ese alcance."

msgid "Save your edits in RetroArch before you leave."
msgstr "Guarda tus cambios en RetroArch antes de salir."

msgid "Recommended shaders are unavailable. Update or reinstall Leaf."
msgstr "Los shaders recomendados no están disponibles. Actualiza o reinstala Leaf."

msgid "RetroArch did not confirm the shader. Reopen Shader or restart the game."
msgstr "RetroArch no confirmó el shader. Vuelve a abrir Shader o reinicia el juego."

msgid "RetroArch is not available. Shader unchanged."
msgstr "RetroArch no está disponible. Shader sin cambios."

msgid "Save globally"
msgstr "Guardar globalmente"

msgid "Save current shader…"
msgstr "Guardar el shader actual…"

msgid "Choose where RetroArch should load this shader automatically."
msgstr "Elige dónde debe cargar RetroArch este shader automáticamente."

msgid "A broader preset may apply after you reload the game."
msgstr "Es posible que se aplique un ajuste predefinido más amplio tras recargar el juego."

msgid "Scope"
msgstr "Alcance"

msgid "Shader"
msgstr "Shader"

msgid "Shader failed and the previous shader could not be restored. Reopen the game."
msgstr "Falló el shader y no se pudo restaurar el anterior. Vuelve a abrir el juego."

msgid "Shader is active for this session, but could not be saved for %s."
msgstr "El shader está activo en esta sesión, pero no se pudo guardar para %s."

msgid "Shader operation failed."
msgstr "Falló la operación del shader."

msgid "Shader scope"
msgstr "Alcance del shader"

msgid "The saved shader could not be removed."
msgstr "No se pudo eliminar el shader guardado."

msgid "This RetroArch build does not support Leaf's shader picker."
msgstr "Esta versión de RetroArch no es compatible con el selector de shaders de Leaf."

msgid "This folder"
msgstr "Esta carpeta"

msgid "This game"
msgstr "Este juego"

msgid "This replaces the shader for every RetroArch game and can replace Fugazi. Continue?"
msgstr "Esto reemplaza el shader para todos los juegos de RetroArch y puede reemplazar Fugazi. ¿Continuar?"

msgid "This shader could not compile or link on this video driver. Previous shader restored."
msgstr "Este shader no se pudo compilar ni vincular en este controlador de video. Se restauró el shader anterior."

msgid "Use Advanced to edit it in RetroArch."
msgstr "Usa Avanzado para editarlo en RetroArch."

msgid "that scope"
msgstr "ese alcance"

