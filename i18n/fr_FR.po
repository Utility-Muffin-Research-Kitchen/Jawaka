# In-game shortcut bindings.
# "Game Switcher" follows the existing "Switcher" -> Game Switch; "Screenshot"
# follows "Screenshots" -> Capture d'écran; "Disabled" pairs with "Enabled" -> Activé.
msgid "Disabled"
msgstr "Désactivé"

msgid "Game Switcher"
msgstr "Sélecteur de jeux"

msgid "Screenshot"
msgstr "Capture d’écran"

# In-game Shortcuts page.
# Saving follows the existing "Save & Quit" -> Sauvegarder et quitter / "Saving" -> Sauvegarde.
# Keyboard-Shortcut is the usual term for a shortcut key binding.
msgid "In-game Shortcuts"
msgstr "Raccourcis en jeu"

msgid "Screenshot Shortcut"
msgstr "Raccourci de capture d’écran"

msgid "Recording Shortcut"
msgstr "Raccourci d’enregistrement"

# Now one printf string, so the action name can sit where Chinese wants it:
# "<action> 已占用" reads as "<action> already has it", rather than the
# English order the old two-fragment concatenation forced.
msgid "Already used by %s"
msgstr "Déjà utilisé par %s"

msgid "Could not save"
msgstr "Impossible d’enregistrer"

# In-game Shortcuts help line.
msgid "Hold Menu, then press the button.   X: Disable"
msgstr "Maintenez Menu, puis appuyez sur le bouton.   X : Désactiver"

# Shown when the binding persisted but the daemon push failed.
msgid "Saved; active after restart"
msgstr "Enregistré ; actif après redémarrage"

# Shortcut picker.
# Follows the file's own entries: "Choose" -> 选择, "Back" -> 返回.
msgid "A: Choose   B: Back"
msgstr "A : Choisir   B : Retour"

# Header fallback when the action name is unavailable; "Shortcut" alone.
msgid "Shortcut"
msgstr "Raccourci"

# In-game shader picker. Reviewed by dapass5 in PR #117 review; fuzzy cleared.
msgid "Advanced RetroArch menu"
msgstr "Menu avancé de RetroArch"

msgid "All RetroArch"
msgstr "Tous les jeux RetroArch"

msgid "All RetroArch requires a Leaf build with Fugazi's conflict resolver."
msgstr "Tous les jeux RetroArch nécessitent une version de Leaf avec le résolveur de conflits de Fugazi."

msgid "Remove the saved preset at the selected scope and turn shaders off."
msgstr "Supprimer le préréglage enregistré à la portée sélectionnée et désactiver les shaders."

msgid "Edit the current shader in RetroArch."
msgstr "Modifier le shader actuel dans RetroArch."

msgid "Leaf's in-game picker supports GLSL presets (.glslp)."
msgstr "Le sélecteur en jeu de Leaf prend en charge les préréglages GLSL (.glslp)."

msgid "Leaf's shader files are incomplete. Update or reinstall Leaf."
msgstr "Les fichiers de shaders de Leaf sont incomplets. Mettez à jour ou réinstallez Leaf."

msgid "No saved shader exists at that scope."
msgstr "Aucun shader enregistré n’existe à cette portée."

msgid "Save your edits in RetroArch before you leave."
msgstr "Enregistrez vos modifications dans RetroArch avant de quitter."

msgid "Recommended shaders are unavailable. Update or reinstall Leaf."
msgstr "Les shaders recommandés sont indisponibles. Mettez à jour ou réinstallez Leaf."

msgid "RetroArch did not confirm the shader. Reopen Shader or restart the game."
msgstr "RetroArch n’a pas confirmé le shader. Rouvrez Shader ou redémarrez le jeu."

msgid "RetroArch is not available. Shader unchanged."
msgstr "RetroArch n’est pas disponible. Shader inchangé."

msgid "Save globally"
msgstr "Enregistrer globalement"

msgid "Save current shader…"
msgstr "Enregistrement du shader actuel…"

msgid "Choose where RetroArch should load this shader automatically."
msgstr "Choisissez où RetroArch doit charger automatiquement ce shader."

msgid "A broader preset may apply after you reload the game."
msgstr "Un préréglage de portée plus large peut s’appliquer après avoir rechargé le jeu."

msgid "Scope"
msgstr "Portée"

msgid "Shader"
msgstr "Shader"

msgid "Shader failed and the previous shader could not be restored. Reopen the game."
msgstr "Échec du shader et impossible de restaurer le shader précédent. Rouvrez le jeu."

msgid "Shader is active for this session, but could not be saved for %s."
msgstr "Le shader est actif pour cette session, mais n’a pas pu être enregistré pour %s."

msgid "Shader operation failed."
msgstr "Échec de l’opération sur le shader."

msgid "Shader scope"
msgstr "Portée du shader"

msgid "The saved shader could not be removed."
msgstr "Impossible de supprimer le shader enregistré."

msgid "This RetroArch build does not support Leaf's shader picker."
msgstr "Cette version de RetroArch ne prend pas en charge le sélecteur de shaders de Leaf."

msgid "This folder"
msgstr "Ce dossier"

msgid "This game"
msgstr "Ce jeu"

msgid "This replaces the shader for every RetroArch game and can replace Fugazi. Continue?"
msgstr "Cela remplace le shader de tous les jeux RetroArch et peut remplacer Fugazi. Continuer ?"

msgid "This shader could not compile or link on this video driver. Previous shader restored."
msgstr "Ce shader n’a pas pu être compilé ou lié avec ce pilote vidéo. Le shader précédent a été restauré."

msgid "Use Advanced to edit it in RetroArch."
msgstr "Utilisez Avancé pour le modifier dans RetroArch."

msgid "that scope"
msgstr "cette portée"

